# Database - PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database

# Admin User - For database seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# Better Auth Secret - Generate with `openssl rand -hex 32` or similar. Read https://better-auth.com/docs/installation
# Set BETTER_AUTH_URL to your actual domain in production
BETTER_AUTH_SECRET=your-super-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing - Get from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your-uploadthing-token